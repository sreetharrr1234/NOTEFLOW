<resources>
    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/noteflow_accent</item>
        <item name="colorPrimaryDark">@color/noteflow_status_bar</item>
        <item name="colorAccent">@color/noteflow_accent</item>
        <item name="android:windowBackground">@color/noteflow_bg</item>
        <item name="android:statusBarColor">@color/noteflow_status_bar</item>
        <item name="android:navigationBarColor">@color/noteflow_navigation_bar</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/noteflow_bg</item>
        <item name="android:statusBarColor">@color/noteflow_status_bar</item>
        <item name="android:navigationBarColor">@color/noteflow_navigation_bar</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="android:windowBackground">@color/noteflow_bg</item>
        <item name="android:statusBarColor">@color/noteflow_status_bar</item>
        <item name="android:navigationBarColor">@color/noteflow_navigation_bar</item>
        <item name="windowSplashScreenBackground">@color/noteflow_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
    </style>
</resources>
